FROM node:20-alpine AS builder
RUN npm install -g pnpm@9

WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json ./lib/db/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY artifacts/sphere-english/package.json ./artifacts/sphere-english/

RUN pnpm install --frozen-lockfile

COPY lib/ ./lib/
COPY artifacts/sphere-english/ ./artifacts/sphere-english/

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
ENV NODE_ENV=production
ENV BASE_PATH=/
ENV PORT=3000

RUN pnpm --filter @workspace/sphere-english build

FROM nginx:alpine
COPY --from=builder /app/artifacts/sphere-english/dist/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
