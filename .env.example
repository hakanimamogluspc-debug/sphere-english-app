# Sphere English LMS — Environment Variables
# Bu dosyayı .env olarak kopyala ve gerçek değerlerle doldur:
#   cp .env.example .env

# ─── ZORUNLU ──────────────────────────────────────────────────────────────────

# JWT imzalama için secret. En az 32 karakter olmalı.
# Üretmek için: openssl rand -base64 48
#   veya: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# PostgreSQL bağlantı URL'i
DATABASE_URL=postgres://user:password@host:5432/sphere

# ─── İSTEĞE BAĞLI ─────────────────────────────────────────────────────────────

# Belirli bir e-postayı admin yap (kayıt olduktan sonra). Boşsa hiçbir şey yapmaz.
SEED_ADMIN_EMAIL=

# OpenAI API anahtarı — AI Studio özellikleri için
OPENAI_API_KEY=

# Resend (e-posta gönderimi)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Apify (otomatik lead keşfi — admin/outreach sayfası)
APIFY_API_TOKEN=
# Segment başına günlük lead limiti (default: 50, ilk hafta için 10-20 öner)
OUTREACH_LIMIT_PER_SEGMENT=20

# Zoom — canlı sınıflar
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Meta Conversions API (Facebook/Instagram reklam pixel'i)
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Iyzico (ödeme — opsiyonel, abonelik aktif olduğunda)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Üretim için
NODE_ENV=production
PORT=8080
STATIC_DIR=

# Frontend build-time API URL (Vite tarafında kullanılır)
VITE_API_URL=
